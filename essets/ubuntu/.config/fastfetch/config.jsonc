{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "ubuntu_small",
    "padding": {
    	"left": 1
    	}
  },
  "modules": [
    "os",
    "kernel",
    "users",
    "memory",
    {
      "type": "disk",
      "format": "{1} / {2} ({3})",
      "folders": "/"
    },
    {
      "type": "disk",
      "key": "  └─ Available (/) ",
      "format": "{size-free}",
      "folders": "/"
    },
    {
      "type": "disk",
      "format": "{1} / {2} ({3})",
      "folders": "/goinfre"
    },
    {
      "type": "disk",
      "key": "  └─ Available (/goinfre) ",
      "format": "{size-free}",
      "folders": "/goinfre"
    },
    {
      "type": "disk",
      "format": "{1} / {2} ({3})",
      "folders": "/home/seunkang"
    },
    {
      "type": "disk",
      "key": "  └─ Available (/home/seunkang) ",
      "format": "{size-free}",
      "folders": "/home/seunkang"
    },
    "localip"
  ],
  "display": {
    "stat": false,
    "color": {
      "force": true,
      "keys": "cyan",
      "output": "white"
    }
  }
}
